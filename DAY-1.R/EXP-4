
# Given data
data <- c(11,13,13,15,15,16,19,20,20,20,21,21,
          22,23,24,30,40,45,45,45,71,72,73,75)

# Divide data into 5 bins
bins <- 5
bin_indices <- cut(data, bins)

# (a) Smoothing by bin mean
mean_smooth <- tapply(data, bin_indices, mean)
print(mean_smooth)

# (b) Smoothing by bin median
median_smooth <- tapply(data, bin_indices, median)
print(median_smooth)

# (c) Smoothing by bin boundaries
boundary_smooth <- lapply(split(data, bin_indices), function(x) {
  lower <- min(x)
  upper <- max(x)
  sapply(x, function(v) {
    if (v - lower <= upper - v) lower else upper
  })
})
print(boundary_smooth)
