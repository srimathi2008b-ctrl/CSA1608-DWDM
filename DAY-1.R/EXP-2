
# Given age data
age <- c(13,15,16,16,19,20,20,21,22,22,25,25,25,25,
         30,33,33,35,35,35,35,36,40,45,46,52,70)

# (a) Mean and Median
mean(age)
median(age)

# (b) Mode
mode_age <- names(table(age))[table(age) == max(table(age))]
mode_age

# (c) Midrange
midrange <- (min(age) + max(age)) / 2
midrange

# (d) First and Third Quartiles
quantile(age, 0.25)
quantile(age, 0.75)
