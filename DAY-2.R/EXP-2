# All Electronics prices
prices <- c(
  1, 1, 5, 5, 5, 5, 5, 8, 8,
  10, 10, 10, 10, 12, 14, 14, 14,
  15, 15, 15, 15, 15, 15,
  18, 18, 18, 18, 18,
  20, 20, 20, 20, 20, 20,
  21, 21, 21, 21,
  25, 25, 25, 25, 25,
  28, 28, 30
)

# Sort the data
prices <- sort(prices)

# Equal-frequency partitioning: 3 bins
bins <- split(prices, rep(1:3, each = ceiling(length(prices)/3))[1:length(prices)])
print(bins)

# Smoothing using bin means
bin_means <- lapply(bins, function(x) rep(mean(x), length(x)))
print(bin_means)

# Smoothing using bin boundaries
smooth_boundary <- function(x) {
  low <- min(x)
  high <- max(x)
  sapply(x, function(v) {
    if (abs(v - low) <= abs(v - high)) low else high
  })
}
boundary_result <- lapply(bins, smooth_boundary)
print(boundary_result)

# Histogram
hist(prices, breaks = 3,
     main = "Histogram of All Electronics Prices",
     xlab = "Price",
     col = "lightblue")
