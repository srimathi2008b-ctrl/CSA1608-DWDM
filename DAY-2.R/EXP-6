# Plot mpg and qsec
plot(mtcars$mpg,
     type = "l",
     col = "blue",
     lwd = 2,
     ylim = range(c(mtcars$mpg, mtcars$qsec)),
     xlab = "Car Index",
     ylab = "Value",
     main = "MPG and QSEC")

lines(mtcars$qsec, col = "red", lwd = 2)

legend("topright",
       legend = c("MPG", "QSEC"),
       col = c("blue", "red"),
       lty = 1)
